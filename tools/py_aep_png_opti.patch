+def png_ihdr(path: str | os.PathLike[str]) -> tuple[int, int, int, int]:
+    """(width, height, bit depth, colour type) from a PNG's IHDR chunk."""
+    with open(path, "rb") as fp:
+        head = fp.read(26)
+    if head[:8] != b"\x89PNG\r\n\x1a\n" or head[12:16] != b"IHDR":
+        raise ValueError(f"{path}: not a PNG file")
+    return struct.unpack(">IIBB", head[16:26])
+
+
+def build_png_opti_data(path: str | os.PathLike[str], total: int = 322) -> bytes:
+    """Build AE's `png!` `opti` asset-info body for a single PNG file.
+
+    Layout copied from AE-written projects (AE 2025/2026 write 322 bytes,
+    AE 2027 326): `png!`, u16 1, u32 body size, 01 00 00 00 00 00 00 01,
+    u32 width, u32 height, u32 bit depth, u32 0, u32 PNG colour type,
+    8 zero bytes, u32 4 (channels), u32 rowbytes (width * 4 * bytes per
+    channel), u32 0, then the file name, NUL-padded to the body size.
+    AE 2027 crashes (PNGIOp_UpdateHeaderFromPNGInfo) on an empty opti.
+    """
+    width, height, bit_depth, color_type = png_ihdr(path)
+    head = (
+        b"png!"
+        + struct.pack(">HI", 1, total)
+        + bytes.fromhex("0100000000000001")
+        + struct.pack(">IIIII", width, height, bit_depth, 0, color_type)
+        + b"\x00" * 8
+        + struct.pack(">III", 4, width * 4 * max(bit_depth // 8, 1), 0)
+    )
+    name = os.path.basename(os.fspath(path)).encode("utf-8")[: total - len(head) - 1]
+    return head + name + b"\x00" * (total - len(head) - len(name))
+
+
+def png_sspc_depth(path: str | os.PathLike[str]) -> int:
+    """`sspc` byte 0x3F for a PNG: bits per pixel incl. alpha (AE: 24 RGB, 32 RGBA).
+
+    AE reads the alpha channel only when this says 32; zero makes it drop alpha.
+    """
+    _w, _h, bit_depth, color_type = png_ihdr(path)
+    channels = 4 if color_type in (4, 6) else 3
+    return channels * 8 * max(bit_depth // 8, 1)
 
 
